# OREOA-AI runtime settings - copy to .env then adapt.
# Versions/pins live in versions.env (managed by make pins); this file is
# runtime configuration only. Secrets are docker secrets, never env vars:
#   secrets/redis_password   (used by the redis service)
#   secrets/llm_api_key      (mounted into agent)

OREOA_CASES=./cases
OREOA_SCRATCH=./.scratch
TAG=dev

# Allow-listed egress endpoints for the proxy (space-separated host:port).
# Empty = no egress at all (use profile local-llm for host LLM endpoints).
LLM_ENDPOINTS=

# Per-role models, read by make runtime-config and the banner.
LLM_MODEL_ANALYST=
LLM_MODEL_TRIAGE=
LLM_MODEL_REVIEWER=

# Hosts excluded from the proxy: internal MCP servers (+ host LLM endpoint
# under the local-llm override file).
NO_PROXY=localhost,127.0.0.1,mcp-evidence,mcp-knowledge,mcp-case,mcp-jobs

# Worker resource caps.
WORKER_FAST_MEM=4g
WORKER_FAST_CPUS=2.0
WORKER_DEEP_MEM=8g
WORKER_DEEP_CPUS=2.0

# Display timezone (storage is UTC).
TZ=Europe/Paris
