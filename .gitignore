# ---- Case data: never versioned (sensitivity and volume) ----
cases/
**/derived/

# ---- Evidence and forensic images ----
*.E01
*.e01
*.raw
*.rawdisk
*.mem
*.dmp
*.pcap
*.pcapng
!corpus/legacy_samples/*.pcap
*.vmdk
*.vhdx
*.vhd
*.qcow2
*.aff4

# ---- Air-gap tool bundles ----
tools/
*.tar.gz
*.tgz

# ---- Upstream knowledge (pinned, fetched by make update-knowledge) ----
knowledge/upstream/

# ---- Volatility symbols (downloaded/generated data; corpus ISF force-added when it lands) ----
knowledge/custom/volatility_symbols/*
!knowledge/custom/volatility_symbols/.gitkeep

# ---- Corpus build outputs (scenarios and generators are versioned, outputs are not) ----
corpus/out/

# ---- Environment and build artifacts ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# ---- Local configuration and secrets ----
.env
.env.*
!.env.example
secrets/
.scratch/

# ---- Evaluation local outputs ----
evaluation/local/

# ---- System and temporary files ----
.DS_Store
Thumbs.db
*.swp
*~
tmp/
*.tmp
*.log
!corpus/legacy_samples/*.log
