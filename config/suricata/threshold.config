# Seuils suricata du kit OREOA-AI - reduction du bruit a l'execution
# Ce fichier remplace /etc/suricata/threshold.config dans l'image (bake a la build).
# Un beacon n'alerte pas a chaque connexion : dedup par hote source et par minute.

# Regles kit - une alerte par hote source et par minute
threshold: gen_id 1, sid 1000001, type limit, track by_src, count 1, seconds 60;
threshold: gen_id 1, sid 1000002, type limit, track by_src, count 1, seconds 60;

# ET Open - ajouter ici les sids bruyants constates en affaire :
#   threshold: gen_id 1, sid <sid>, type limit, track by_src, count 1, seconds 60;
# Silence cible d'une regle pour un hote connu :
#   suppress: gen_id 1, sid <sid>, track by_src, ip <hote>;
