{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "instructions": ["AGENTS.md", "skills/ingestion.md", "skills/triage.md", "skills/analyse.md", "skills/reporting.md", "skills/guidance.md"],
  "permission": {
    "edit": "ask",
    "bash": {
      "python3 scripts/doctor.py check": "allow",
      "python3 scripts/doctor.py test": "allow",
      "python3 scripts/doctor.py fix": "allow",
      "python3 scripts/ingest.py *": "allow",
      "dt *": "allow",
      "*": "ask"
    },
    "webfetch": "ask"
  }
}
