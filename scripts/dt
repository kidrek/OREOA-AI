#!/usr/bin/env bash
# dt - containerized execution wrapper of the OREOA-AI kit tools
# Usage:
#   dt [-c CASE_ID] <tool> [args...]
# Examples:
#   dt yara /tests/samples/rules.yar /tests/samples/testfile.bin
#   dt -c CASE-2026-0042 log2timeline --storage-file 02_analysis/timeline/timeline.plaso 00_evidence/exports/collection.jsonl
# Rules enforced:
#   - 00_evidence mounted read-only; 01_work and 02_analysis writable
#   - network disabled; non-root user (uid/gid of the analyst)
#   - oreoa-ai-tools image required (provisioning: python3 scripts/doctor.py fix)
set -euo pipefail

KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="oreoa-ai-tools:1.1.0"

CASE_ID=""
while [[ "${1:-}" == "-c" ]]; do
  CASE_ID="${2:?Usage : dt [-c CASE_ID] <outil> [args...]}"
  shift 2
done

if [[ $# -lt 1 ]]; then
  echo "Usage: dt [-c CASE_ID] <tool> [args...]" >&2
  echo "Tools: log2timeline psort vol fls icat tshark suricata yara" >&2
  exit 2
fi

OUTIL="$1"; shift

# The image must be present (provisioning: doctor.py fix)
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Error: image $IMAGE missing. Provision with: python3 scripts/doctor.py fix" >&2
  exit 1
fi

cd "$KIT_DIR"
MOUNTS=(-v "$(pwd)/tests:/tests:ro"
        -v "$(pwd)/scripts:/work/scripts:ro"
        -v "$(pwd)/catalogue:/work/catalogue")
if [[ -d "referentiels-kit" ]]; then
  MOUNTS+=(-v "$(pwd)/referentiels-kit:/referentiels-kit:ro")
fi
if [[ -n "$CASE_ID" ]]; then
  CASE_DIR="cases/$CASE_ID"
  [[ -d "$CASE_DIR" ]] || { echo "Error: unknown case: $CASE_DIR" >&2; exit 1; }
  [[ -f "$CASE_DIR/manifest.yaml" ]] || printf 'affaire:\n  id: "%s"\ncollections: []\n' "$CASE_ID" > "$CASE_DIR/manifest.yaml"
  MOUNTS+=(
    -v "$(pwd)/$CASE_DIR/00_evidence:/affaires/00_evidence:ro"
    -v "$(pwd)/$CASE_DIR/01_work:/affaires/01_work"
    -v "$(pwd)/$CASE_DIR/02_analysis:/affaires/02_analysis"
    -v "$(pwd)/$CASE_DIR/manifest.yaml:/affaires/manifest.yaml"
    -w /affaires
  )
else
  MOUNTS+=(-w /tmp)
fi

exec docker run --rm \
  --network none \
  --user "$(id -u):$(id -g)" \
  "${MOUNTS[@]}" \
  "$IMAGE" "$OUTIL" "$@"
