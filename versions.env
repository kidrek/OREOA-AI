# OREOA-AI - pins resolves par make pins (initial: 2026-09-04).
# Une ligne par pin, pas de valeur sur la meme ligne qu'un commentaire.
# Seul make pins est autorise a editer ce fichier (PR obligatoire pour un pin).
# Les Dockerfiles recoivent les valeurs comme build args.

# Images de base. Proxy/proxy-fetch = debian:bookworm-slim (deviation
# journalisee 2026-09-04 : le paquet alpine tinyproxy est compile sans le
# module Filter, directive Filter indisponible).
PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
NODE_IMAGE=node:22-bookworm-slim
OPENCODE_VERSION=1.18.27
CLAUDE_CODE_VERSION=2.1.260
DEBIAN_IMAGE=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
TINYPROXY_VERSION=1.11.1-2.1+deb12u1
REDIS_IMAGE=redis:8.8.2-alpine3.23

# Outils Python (pip) - packages de traitement, installes dans les images
DISSECT_VERSION=3.25.1
PLASO_VERSION=20260720
VOLATILITY3_VERSION=2.28.0
YARA_PYTHON_VERSION=4.5.4
PYARROW_VERSION=25.0.1
DUCKDB_VERSION=1.5.5
RQ_VERSION=2.12.0
MCP_VERSION=2.1.1

# Image one-shot du refresh ClamAV (make update-knowledge, defaut ;
# freshclam ecrit la db dans knowledge/upstream/clamav_db/).
CLAMAV_IMAGE=clamav/clamav:1.5.4-debian13-slim

# Conteneur one-shot du build corpus (make corpus, S1.6) : mkntfs + ntfscp
# sur fichiers reguliers, sans montage. Base = DEBIAN_IMAGE, paquet pinne.
NTFS3G_VERSION=1:2022.10.3-1+deb12u3

# Outils forensiques (binaires release GitHub, checksums verifies au build) -
# pinnes a l'etape 2 du work order (build order docker_build_spec 11.2).
# Note: zircolite n'est pas sur PyPI, il est traite comme binaire release.
HAYABUSA_VERSION=
HAYABUSA_SHA256=
CHAINSAW_VERSION=
CHAINSAW_SHA256=
ZIRCOLITE_VERSION=
ZIRCOLITE_SHA256=
CAPA_VERSION=
CAPA_SHA256=
FLOSS_VERSION=
